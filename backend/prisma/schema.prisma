generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id         Int       @id @default(autoincrement())
  wa_number  String    @unique
  name       String
  skpd_name  String?
  created_at DateTime  @default(now())
  tickets    Ticket[]
}

// Menggantikan Division menjadi Category (Fase 1 - V2)
model Category {
  id               Int               @id @default(autoincrement())
  name             String
  wa_target_number String?          // Nomor grup/teknisi WA untuk Blast Notifikasi (Legacy)
  users            User[]
  tickets          TicketCategory[]
  contacts         CategoryContact[] // Relasi Multi-Kontak WA Blast (Fase 1 - V2.2)
}

// Tabel Multi-Kontak Teknisi / Grup WA per Tim L2 (Fase 1 - V2.2)
model CategoryContact {
  id          Int      @id @default(autoincrement())
  category_id Int
  name        String   // Misal: "Budi (Teknisi 1)" atau "Grup WA Network"
  wa_target   String   // Misal: "628123456789" atau "1203632948293@g.us"
  created_at  DateTime @default(now())
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

// Tabel Konfigurasi Dinamis (Auto-Reply Bot dsb) (Fase 1 - V2.2)
model Setting {
  key        String   @id // Contoh: "auto_reply"
  value      String   @db.Text // Isi template pesan balasan
  is_active  Boolean  @default(true) // Sakelar ON / OFF
  updated_at DateTime @updatedAt
}

model User {
  id          Int        @id @default(autoincrement())
  name        String
  email       String     @unique
  password    String
  role        Role       @default(L2)
  category_id Int?
  category    Category?  @relation(fields: [category_id], references: [id])
}

model Ticket {
  id          Int              @id @default(autoincrement())
  customer_id Int
  customer    Customer         @relation(fields: [customer_id], references: [id])
  status      TicketStatus     @default(OPEN)
  service_type ServiceType?
  summary     String?
  created_at  DateTime         @default(now())
  closed_at   DateTime?
  categories  TicketCategory[]
  messages    Message[]
}

// Tabel relasi Many-to-Many antara Tiket dan Kategori
model TicketCategory {
  ticket_id   Int
  category_id Int
  is_resolved Boolean  @default(false)
  resolved_at DateTime?
  ticket      Ticket   @relation(fields: [ticket_id], references: [id])
  category    Category @relation(fields: [category_id], references: [id])

  @@id([ticket_id, category_id])
}

model Message {
  id             Int        @id @default(autoincrement())
  ticket_id      Int
  ticket         Ticket     @relation(fields: [ticket_id], references: [id])
  sender_type    SenderType
  sender_id      Int?
  message_text   String?
  attachment_url String?
  is_internal    Boolean    @default(false) // Penanda apakah ini Catatan Internal L2 (Fase 1 - V2)
  created_at     DateTime   @default(now())
}

enum Role {
  ADMIN
  SPV
  L1
  L2
}

enum TicketStatus {
  OPEN
  RESOLVED // Status baru: L2 selesai, menunggu L1 close (Fase 1 - V2)
  CLOSED
}

enum SenderType {
  CUSTOMER
  AGENT
  BOT
}

enum ServiceType {
  TROUBLESHOOTING
  REQUEST_LAYANAN
  MONITORING
}
