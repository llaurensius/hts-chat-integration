PORT=3000
DATABASE_URL="postgresql://helpdesk_user:<POSTGRES_PASSWORD>@localhost:5433/wa_helpdesk?schema=public"

# Keamanan JWT (Ganti dengan string rahasia 32+ karakter acak)
JWT_SECRET="<RANDOM_JWT_SECRET_32_CHARS_OR_MORE>"

# Kunci Enkripsi Sesi HTS AES-256 (String rahasia 32+ karakter acak)
SESSION_ENCRYPTION_KEY="GantiDenganKunciEnkripsiSesiHTSYangKuatDanUnik123!"

# Evolution API
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_TOKEN="<RANDOM_EVOLUTION_API_TOKEN>"
EVOLUTION_INSTANCE_NAME="helpdesk-wa"
WEBHOOK_SECRET="<RANDOM_WEBHOOK_SECRET_DIFFERENT_FROM_EVOLUTION_TOKEN>"

# Frontend Origin untuk CORS
# Frontend Origin untuk CORS (Bisa multi-origin dipisah koma, misal: http://localhost:5200,http://103.xxx.xxx.xxx:5200)
FRONTEND_URL="http://localhost:5200"
